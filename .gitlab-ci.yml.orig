    file: GitLab/Templates/gitlab-job-templates.yml

variables:
  ImageName: pgtgs/viplevels-level
  TgsSettingKey: viplevels-level
  HelmTemplateFolderName: viplevels-level
  BuildCacheKey: Tgs.VipLevels.Level.$CI_PIPELINE_IID

stages:
  - build
  - test
  - publish
  - deploy-dev
  - deploy-staging
  - deploy-prod

build-code:
  extends: .build-code-template

unit-test:
  extends: .unit-test-template
  script:
    - dotnet test -c $BuildConfiguration -l:"junit;LogFilePath=../TestReports/{assembly}-TestReport.xml" --no-restore --no-build

push-nuget:
  extends: .push-nuget-template
  script:
    - push_package "Tgs.VipLevels.Level.Client"
  artifacts:
    paths:
      - Tgs.VipLevels.Level.Client/bin/$BuildConfiguration/*.nupkg

push-docker-image:
  extends: .push-docker-image-template
  script:
    - push_docker "Tgs.VipLevels.Level" $ImageName $Tag

push-k8s-template:
  extends: .push-k8s-template
  script:
    - push_k8s_template $HelmTemplateFolderName $ImageName $Tag

deploy-dev:
  extends: .deploy-k8s-template
  image: 
    name: pgtgs/tgs-backend-deploy:latest
  variables:
    namespace: dev
    replica: 1
    DedicatedKey: dedicated
    NodeSelectorKey: node-selector
  environment:
    name: service-dev
  stage: deploy-dev
  tags:
    - dev
    - kubernetes
    - deploy
  needs:
    - push-docker-image
    - job: push-k8s-template
      artifacts: true
  only:
    - main
  when: on_success
  script:
    - deploy_k8s $TgsSettingKey $HelmTemplateFolderName $namespace

deploy-staging:
  extends: .deploy-k8s-template
  image: 
    name: pgtgs/tgs-backend-deploy:latest
  variables:
    namespace: staging
    replica: 1
    DedicatedKey: dedicated
    NodeSelectorKey: node-selector
  environment:
    name: service-staging
  stage: deploy-staging
  tags:
    - staging
    - kubernetes
    - deploy
  needs:
    - deploy-dev
    - job: push-k8s-template
      artifacts: true
  only:
    - main
  when: manual
  script:
    - deploy_k8s $TgsSettingKey $HelmTemplateFolderName $namespace

deploy-prod:
  extends: .deploy-k8s-template
  image: 
    name: pgtgs/tgs-backend-deploy:latest
  variables:
    namespace: prod
    replica: 1
    DedicatedKey: dedicated
    NodeSelectorKey: node-selector
  environment:
    name: service-prod
  stage: deploy-prod
  tags:
    - prod
    - kubernetes
    - deploy
  needs:
    - deploy-staging
    - job: push-k8s-template
      artifacts: true
  only:
    - main
  when: manual
  script:
    - deploy_k8s $TgsSettingKey $HelmTemplateFolderName $namespace
