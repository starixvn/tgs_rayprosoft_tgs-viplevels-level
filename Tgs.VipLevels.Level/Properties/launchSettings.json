        "OTEL_SERVICE_NAME": "VipLevels-Level(local)",
        "NODE_IP": "otel.rpgp.cc"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5071"
    },
    "https": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_SERVICE_NAME": "VipLevels-Level(local)",
        "NODE_IP": "otel.rpgp.cc"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:7007;http://localhost:5071"
